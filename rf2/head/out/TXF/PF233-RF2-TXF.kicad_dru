(version 1)
(rule "generic" (constraint clearance (min 0.2mm)))
(rule "track" (constraint track_width (min 0.15mm)))
(rule "edge" (constraint edge_clearance (min 0.5mm)))
(rule "via" (constraint via_diameter (min 0.6mm)) (condition "A.Type == 'Via'"))
(rule "via drill" (constraint hole_size (min 0.3mm)) (condition "A.Type == 'Via'"))
(rule "HV rule 6" (constraint clearance (min 1.0mm)) (condition "A.NetName == 'TX_A' || B.NetName == 'TX_A' || A.NetName == 'TX_B' || B.NetName == 'TX_B'"))
(rule "wide TX_A" (constraint track_width (min 2.0mm)) (condition "A.NetName == 'TX_A'"))
(rule "wide TX_B" (constraint track_width (min 2.0mm)) (condition "A.NetName == 'TX_B'"))
