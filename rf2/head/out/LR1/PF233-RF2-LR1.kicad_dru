(version 1)
(rule "generic" (constraint clearance (min 0.1mm)))
(rule "track" (constraint track_width (min 0.1mm)))
(rule "edge" (constraint edge_clearance (min 0.5mm)))
(rule "via" (constraint via_diameter (min 0.45mm)) (condition "A.Type == 'Via'"))
(rule "via drill" (constraint hole_size (min 0.2mm)) (condition "A.Type == 'Via'"))
